# Fail2ban Alert Configuration
# Deployed by: solti-ensemble/roles/alert_notifier

state_dir: /var/lib/fail2ban-alert
cooldown_minutes: {{ fail2ban_alert_cooldown_minutes }}

loki:
  url: {{ fail2ban_alert_loki_url }}

alert:
  threshold: {{ fail2ban_alert_threshold }}

channels:
  email:
    enabled: {{ (fail2ban_alert_smtp_host | length > 0) | bool | lower }}
    host: "{{ fail2ban_alert_smtp_host }}"
    port: {{ fail2ban_alert_smtp_port }}
    username: "{{ fail2ban_alert_smtp_username }}"
    password: "{{ fail2ban_alert_smtp_password }}"
    from_address: "{{ fail2ban_alert_from_address }}"
    recipients: "{{ fail2ban_alert_recipients }}"

  matrix:
    enabled: {{ alert_notifier_matrix_enabled | bool | lower }}
    homeserver: "{{ alert_notifier_matrix_homeserver }}"
    token: "{{ alert_notifier_matrix_token }}"
    room_id: "{{ alert_notifier_matrix_room_id }}"

  redis:
    enabled: {{ alert_notifier_redis_enabled | bool | lower }}
    url: "{{ alert_notifier_redis_url }}"
    channel: "{{ alert_notifier_redis_channel }}"

  amqp:
    enabled: {{ alert_notifier_amqp_enabled | bool | lower }}
    url: "{{ alert_notifier_amqp_url }}"
    exchange: "{{ alert_notifier_amqp_exchange }}"
    routing_key: "{{ alert_notifier_amqp_routing_key }}"
