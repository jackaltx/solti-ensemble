[Unit]
Description=GitHub CI Watcher — IMAP poller for CI notification emails
Documentation=https://github.com/jackaltx/solti-ensemble
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gh-watcher.py
User={{ gh_watcher_user }}
Group={{ gh_watcher_group }}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gh-watcher

# Security hardening — no privilege escalation needed (IMAP + notifier only)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gh-watcher
