{% raw %}#!/usr/bin/env python3
"""
Fail2ban alert sensor — queries Loki for ban rate, dispatches via _notifier_base.
Deployed by: solti-ensemble/roles/fail2ban_alert
"""
import sys
import time
import yaml
import requests

sys.path.insert(0, '/usr/local/lib/solti')
import notifier

CONFIG_FILE = "/etc/fail2ban-alert/config.yml"


def load_config():
    with open(CONFIG_FILE) as f:
        return yaml.safe_load(f)


def query_loki_ban_rate(config):
    """Query Loki for fail2ban ban count in last hour."""
    loki_url = config['loki']['url']
    query = '''
    sum(count_over_time(
      {service_type="fail2ban"}
      | regexp `\[(?P<action>Ban)\]`
      [1h]
    ))
    '''
    try:
        resp = requests.get(
            f"{loki_url}/loki/api/v1/query",
            params={'query': query.strip(), 'time': int(time.time() * 1e9)},
            timeout=10,
        )
        resp.raise_for_status()
        data = resp.json()
        if data['status'] == 'success' and data['data']['result']:
            return int(data['data']['result'][0]['value'][1])
    except Exception as e:
        print(f"sensor: Loki query error: {e}")
    return 0


def main():
    try:
        config = load_config()
    except Exception as e:
        print(f"sensor: config error: {e}")
        return 1

    threshold = config['alert']['threshold']
    ban_count = query_loki_ban_rate(config)
    print(f"fail2ban bans (last 1h): {ban_count} (threshold: {threshold})")

    if ban_count > threshold:
        ev = notifier.event(
            source="fail2ban",
            severity="warn",
            summary=f"{ban_count} bans in last hour (threshold: {threshold})",
            detail={
                "ban_count": ban_count,
                "threshold": threshold,
                "loki_url": config['loki']['url'],
            },
        )
        dispatched = notifier.notify_with_cooldown(ev, config)
        if not dispatched:
            print("alert suppressed (cooldown active)")
    else:
        print("rate below threshold, no alert")

    return 0


if __name__ == '__main__':
    sys.exit(main())
